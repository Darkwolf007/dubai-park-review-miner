# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Server-Side API Key for Places Details queries.
# Put this in AI Studio Secrets to enable live, secure, server-proxied places fetching.
# This ensures your key is NEVER exposed in the client-side JavaScript bundles.
GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: For local browser-side maps testing during development.
# Only use for local development; prefer GOOGLE_MAPS_PLATFORM_KEY for server proxy in production.
VITE_GOOGLE_MAPS_API_KEY="YOUR_DEV_ONLY_MAPS_API_KEY"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: safe to expose in the browser bundle -- every
# request made with the anon key is still checked against Row Level Security. Found in the
# Supabase dashboard under Project Settings -> API.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# SUPABASE_URL: same project as VITE_SUPABASE_URL, without the VITE_ prefix -- read by the Python
# backend (Step 18), which never goes through Vite's bundler.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: backend-only, NEVER prefix with VITE_ (that would bundle it into the
# browser). Used exclusively by the FastAPI backend (Step 18) -- bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# VITE_BACKEND_URL: where the FastAPI backend (Step 18) is running -- the frontend calls this
# directly (not through Supabase) to trigger dataset processing / analysis runs.
VITE_BACKEND_URL="http://localhost:8000"

# PARK_BRAIN_URL: server-side URL for the independent citation and approved-rule knowledge service.
# Results queries it through the Express /api/park-brain/query proxy; do not prefix this with VITE_.
PARK_BRAIN_URL="http://127.0.0.1:8000"
